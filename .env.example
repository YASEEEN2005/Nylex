# ====================================================================
# NYLEX Digital Studio - Environment Variables Example (.env.example)
# Copy this file to .env.local for local development.
# Configure these variables in Vercel > Project Settings > Environment Variables for production.
# ====================================================================

# 1. Neon PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[endpoint-pooler].[region].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 2. Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 3. Security & Admin Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=your_secure_admin_password

# 4. App URL (Optional, useful for canonical references and webhook callbacks)
NEXT_PUBLIC_APP_URL=https://nylex.online

